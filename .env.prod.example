# Settings for docker-compose.prod.yml: ORM_AI on one server.
# Copy to .env.prod (git-ignored), fill in the values marked REQUIRED, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# docs/deploy.md walks through it. Never commit .env.prod: it holds your secrets.

# --- Addresses (REQUIRED) -------------------------------------------------------------
# Where browsers reach the website and the API, as your HTTPS proxy serves them.
# PUBLIC_API_URL is built into the website's JavaScript: rebuild after changing it.
PUBLIC_API_URL=https://api.your-domain.example
CORS_ORIGINS=https://your-domain.example

# --- Secrets (REQUIRED) ---------------------------------------------------------------
# Signs login tokens. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
POSTGRES_PASSWORD=
POSTGRES_USER=orm_ai
POSTGRES_DB=orm_ai

# --- Public demo (optional) -----------------------------------------------------------
# Demo accounts anyone may log in as from the login page (never an admin). Leave empty
# on a real deployment: then only tokens from your own login system work.
AUTH_DEMO_USERS=

# --- The model (REQUIRED for the agents) ----------------------------------------------
# Same settings as the local .env (see docs/agents.md, section 7). Google Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL_FAST=gemini-3.5-flash-lite   LLM_MODEL_SMART=gemini-3.8-flash
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_MODEL_FALLBACK=
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=
LLM_MAX_RETRIES=5
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- The demo data ---------------------------------------------------------------------
# "Today" for the synthetic shops (their records end on 2026-09-30).
BUSINESS_DATE=2026-09-30

# --- Ports on the server (published on 127.0.0.1 only, for your HTTPS proxy) -----------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Optional ----------------------------------------------------------------------------
LOG_LEVEL=INFO
RATE_LIMIT_AGENT=20/minute
RATE_LIMIT_UPLOAD=10/hour
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orm-ai
