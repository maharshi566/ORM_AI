# Copy this file to .env and fill in the blanks. Never commit .env.
# Used by docker compose and by the backend (backend/app/config/settings.py).

# ---- App ----
APP_NAME=ORM_AI
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=orm_ai
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=orm_ai
POSTGRES_PORT=5432
# Used when the backend runs on your machine. Keep the user/password in sync with the values above.
DATABASE_URL=postgresql+asyncpg://orm_ai:change_me_local_only@localhost:5432/orm_ai

# Using Supabase instead (see docs/supabase.md)? Use the SESSION pooler string from
# Supabase > Connect, change "postgresql://" to "postgresql+asyncpg://" and add ?ssl=require:
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST.pooler.supabase.com:5432/postgres?ssl=require
# Only if you use the TRANSACTION pooler (port 6543) instead:
# DB_TRANSACTION_POOLER=true

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Backend port (docker compose) ----
BACKEND_PORT=8000

# ---- Optional tools (docker compose profiles; see docs/database.md and docs/omniroute.md) ----
# docker compose --profile tools up -d adminer       a web page for browsing PostgreSQL
ADMINER_PORT=8080
# docker compose --profile gateway up -d omniroute   OmniRoute, a gateway to many AI providers
OMNIROUTE_PORT=20128
OMNIROUTE_VERSION=3.8.50

# ---- Synthetic data ----
# The demo data ends on 2026-09-30. Freezing "today" there keeps "days overdue" and
# "days late" matching the planted edge cases. Remove this line for real data.
BUSINESS_DATE=2026-09-30

# ---- Mock external APIs (supplier + WhatsApp/SMS gateway) ----
# none | timeout | server_error | not_found | rate_limited | random
MOCK_API_FAILURE_MODE=none
MOCK_API_LATENCY_MS=0

# ---- Knowledge search / RAG (Phase 3) ----
# Where ChromaDB keeps its files (relative paths start at backend/).
CHROMA_PERSIST_DIR=./data/chroma
# heuristic (free, default) | llm (re-scores results with LLM_MODEL_FAST) | none
RERANKER=heuristic
# Leave empty to use the embedding model's default. scripts.eval_retrieval suggests a value.
RETRIEVAL_MIN_SIMILARITY=

# ---- AI models (embeddings from Phase 3, agents from Phase 4) ----
# Choose ONE way to reach the models.
#
# Way 1: OpenAI directly. Create a key at platform.openai.com and set a monthly limit.
# Never share or commit it.
OPENAI_API_KEY=
#
# Way 2: a gateway such as OmniRoute (see docs/omniroute.md). Leave LLM_BASE_URL empty to use
# OpenAI. With a gateway, put its key in LLM_API_KEY (copy it from the gateway's dashboard).
#
# Way 3: OpenRouter (openrouter.ai, one key for many providers' models):
#   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_API_KEY=your OpenRouter key
#   model names look like openai/gpt-5.4-mini (python -m scripts.check_llm --list openai/)
#
# Free: Google's Gemini API (key at aistudio.google.com/apikey; free-tier prompts may be
# used by Google, so only for made-up data; see docs/agents.md, section 7):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=your Gemini key   LLM_MODEL_FAST=gemini-3.5-flash-lite   LLM_MODEL_SMART=gemini-3.8-flash
#   LLM_MODEL_FALLBACK=gemini-3.6-flash   LLM_REASONING_EFFORT=low   LLM_MAX_RETRIES=5
LLM_BASE_URL=
LLM_API_KEY=
# Only if the embeddings must come from somewhere else than the chat models, for example chat
# through the gateway and embeddings straight from OpenAI:
#   EMBEDDING_BASE_URL=https://api.openai.com/v1   and   EMBEDDING_API_KEY=your OpenAI key
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
#
# A small, fast model for triage/validation and a stronger one for investigation/replies.
# OpenAI: model names from platform.openai.com. OmniRoute: for example auto/fast and auto/smart,
# or any name that `python -m scripts.check_llm --list` prints.
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# Optional: tried once when the main model still fails after its retries (not for a bad key).
LLM_MODEL_FALLBACK=
# auto (strict JSON schema, falling back to JSON mode for models without it), json_schema,
# or json_object. Leave auto unless check_llm says JSON schema is not supported.
LLM_STRUCTURED_OUTPUT=auto
# Reasoning models only (OpenAI's gpt-5 family and newer): low makes the agents faster
# and cheaper. Leave empty for other models; they reject the setting.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# text-embedding-3-small (needs OpenAI), the name of an embedding model your gateway offers
# (`python -m scripts.check_llm --list embed`), or "hash" to try search offline without a key.
EMBEDDING_MODEL=text-embedding-3-small
# Test whatever you chose:  python -m scripts.check_llm

# ---- Agents (Phase 4) ----
# database: every workflow step is saved in PostgreSQL (needed for approvals in Phase 5).
# memory: kept in the backend process only, lost on restart (fine for a quick demo).
CHECKPOINTER=database
# How often the investigation may ask for more data, and the validator for a rewrite.
AGENT_MAX_LOOPS=2
# Tool calls the data agent may make per visit.
AGENT_MAX_TOOL_CALLS=8
# Phase 5: after its own checks pass, the validator asks the fast model whether every claim
# in the reply is supported. One more model call per reply, so off by default.
VALIDATOR_LLM_JUDGE=false
# Earlier messages the agents see, and how long Redis keeps a quiet conversation.
SESSION_MEMORY_TURNS=10
SESSION_TTL_HOURS=24

# ---- API: logins, limits and uploads (Phase 6) ----
# Signs login tokens. Locally it may stay empty (a random secret is made at each start, so
# tokens stop working after a restart). Production refuses to start without one of at least
# 32 characters. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# false (local): calls without a token still work and say who they are in the body (user_id).
# true (production): every chat, approval and record call needs a token for that user's shop.
AUTH_REQUIRED=false
AUTH_TOKEN_HOURS=12
# POST /api/auth/dev-token hands out a token for any user ID, for the demo. Always refused
# when APP_ENV=production.
AUTH_DEV_LOGIN=true
# Requests per user (or per address without a token). Format: 20/minute, 100/hour, 5/second.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AGENT=20/minute
RATE_LIMIT_UPLOAD=10/hour
# memory (one backend process) or a Redis URL, e.g. redis://localhost:6379/1, so that several
# backend processes share the same counts.
RATE_LIMIT_STORAGE=memory
# Uploaded knowledge documents (.md, .txt, .pdf). Relative paths start at backend/.
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=5

# ---- LangSmith tracing (Phase 4) ----
# A trace contains the shop records the agents read: keep it off for real shops unless
# the owner agrees. Free account and key: smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orm-ai
