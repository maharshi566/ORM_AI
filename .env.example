# Copy this file to .env and fill in the blanks. Never commit .env.
# Used by docker compose and by the backend (backend/app/config/settings.py).

# ---- App ----
APP_NAME=ORM_AI
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=orm_ai
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=orm_ai
POSTGRES_PORT=5432
# Used when the backend runs on your machine. Keep the user/password in sync with the values above.
DATABASE_URL=postgresql+asyncpg://orm_ai:change_me_local_only@localhost:5432/orm_ai

# Using Supabase instead (see docs/supabase.md)? Use the SESSION pooler string from
# Supabase > Connect, change "postgresql://" to "postgresql+asyncpg://" and add ?ssl=require:
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST.pooler.supabase.com:5432/postgres?ssl=require
# Only if you use the TRANSACTION pooler (port 6543) instead:
# DB_TRANSACTION_POOLER=true

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Backend port (docker compose) ----
BACKEND_PORT=8000

# ---- Synthetic data ----
# The demo data ends on 2026-09-30. Freezing "today" there keeps "days overdue" and
# "days late" matching the planted edge cases. Remove this line for real data.
BUSINESS_DATE=2026-09-30

# ---- Mock external APIs (supplier + WhatsApp/SMS gateway) ----
# none | timeout | server_error | not_found | rate_limited | random
MOCK_API_FAILURE_MODE=none
MOCK_API_LATENCY_MS=0

# ---- Knowledge search / RAG (Phase 3) ----
# Where ChromaDB keeps its files (relative paths start at backend/).
CHROMA_PERSIST_DIR=./data/chroma
# heuristic (free, default) | llm (re-scores results with LLM_MODEL_FAST) | none
RERANKER=heuristic
# Leave empty to use the embedding model's default. scripts.eval_retrieval suggests a value.
RETRIEVAL_MIN_SIMILARITY=

# ---- OpenAI (embeddings from Phase 3, agents from Phase 4) ----
# Create a key at platform.openai.com and set a monthly limit. Never share or commit it.
OPENAI_API_KEY=
# A small, fast model for triage/validation and a stronger one for investigation/replies
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# text-embedding-3-small (needs the key), or "hash" to try search offline without a key
EMBEDDING_MODEL=text-embedding-3-small

# ---- LangSmith tracing (Phase 4) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orm-ai
